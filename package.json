{
  "name": "seigem",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run lint",
    "test:rules": "firebase emulators:exec --only firestore --project seigem-rules-test \"node --test --experimental-strip-types tests/firestore.rules.test.ts\"",
    "test:extract": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/extraction.test.ts",
    "test:uploader": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/uploader.test.ts",
    "test:render": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/render.test.ts",
    "test:unit": "npm run test:extract && npm run test:uploader && npm run test:render && npm run test:dashboard && npm run test:generate && npm run test:quota && npm run test:plans && npm run test:history && npm run test:study && npm run test:summary && npm run test:security && npm run test:ai && npm run test:deepseek && npm run test:billing && npm run test:billing-state",
    "test:bundle": "node tests/verify-browser-bundle.mjs",
    "test": "npm run test:unit && npm run test:rules",
    "fixtures": "node tests/fixtures/generate-fixtures.mjs",
    "emulators": "firebase emulators:start --only firestore,auth",
    "test:generate": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/generation.test.ts",
    "test:quota": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/quota.test.ts",
    "test:ai": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/ai.test.ts",
    "test:deepseek": "node --import ./tests/register-loader.mjs --test tests/deepseek.test.mjs",
    "test:plans": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/plans.test.ts",
    "test:billing": "node --import ./tests/register-loader.mjs --test tests/billing.test.mjs",
    "test:billing-state": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/billing-state.test.ts",
    "test:history": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/history.test.ts",
    "test:study": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/study.test.ts",
    "test:security": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/security.test.ts",
    "test:dashboard": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/dashboard-render.test.tsx",
    "test:summary": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/summary.test.ts",
    "test:whop-webhook": "node --import ./tests/register-loader.mjs --test --experimental-strip-types tests/whop-webhook.test.ts",
    "test:tracing": "node tests/verify-tracing-includes.mjs",
    "test:admin-loader": "node tests/verify-admin-loader.mjs",
    "tracing:generate": "node scripts/generate-tracing-includes.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "^15.30.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "jose": "^5.9.6"
  }
}
