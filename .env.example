# =============================================================================
# Seigem — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed.
# This `.env.example` file contains placeholders only — no real secrets.
#
# Next.js loads `.env.local` automatically on `npm run dev` and `npm run build`.
# After changing any value you must restart the dev server.
#
# -----------------------------------------------------------------------------
# PUBLIC vs SERVER-ONLY
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_*  -> Embedded into the browser bundle. Anyone can read these.
#                   NEVER put a secret in a NEXT_PUBLIC_ variable.
# Everything else -> Server-only. Read via `src/lib/env/server.ts`, which
#                   imports "server-only" so an accidental client import fails
#                   at build time instead of leaking the secret.
#
# An empty value is treated as missing. Required variables throw a clear error
# at startup; optional ones fall back to the default shown in their comment.
# =============================================================================


# =============================================================================
# 1. FIREBASE — PUBLIC (browser SDK configuration)
# =============================================================================
# Where to find these: Firebase Console -> Project settings -> Your apps ->
# Web app -> SDK setup and configuration -> Config.
#
# These values are not secrets. They identify your Firebase project and are
# protected by Firestore Security Rules and the Authorized domains list.
# -----------------------------------------------------------------------------

# Required. Public identifier for your Firebase project's Web API.
# Format: starts with "AIza", ~39 characters.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Required. Domain that hosts the Firebase Auth sign-in handler.
# Format: <project-id>.firebaseapp.com
# Must also be listed under Authentication -> Settings -> Authorized domains.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Required. Your Firebase / Google Cloud project id.
# Must match FIREBASE_PROJECT_ID below (the Admin SDK value).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# OPTIONAL — but recommended for compatibility with the Firebase console.
#
# The master prompt allows this variable "only if technically required by
# Firebase configuration". Verified against the installed SDK: it is NOT
# required by Seigem.
#   - `storageBucket` is read exclusively by `@firebase/storage`, and Seigem
#     never imports that package. Document files are parsed in the browser and
#     never uploaded, so Cloud Storage is unused.
#   - `initializeApp()` and `initializeServerApp()` both accept a config
#     object without this key.
#
# It is kept here because the snippet the Firebase console generates includes
# it, so pasting that snippet verbatim must not break anything. Leave it empty
# unless you deliberately enable Cloud Storage later.
# Format: <project-id>.appspot.com  (or <project-id>.firebasestorage.app)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Required. Sender id used by Firebase Cloud Messaging.
# Format: numeric string, e.g. 123456789012
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Required. Unique identifier of the registered Web app.
# Format: 1:<sender-id>:web:<hash>
NEXT_PUBLIC_FIREBASE_APP_ID=


# =============================================================================
# 2. FIREBASE ADMIN SDK — SERVER-ONLY. NEVER EXPOSE.
# =============================================================================
# Where to find these: Firebase Console -> Project settings -> Service accounts
# -> Generate new private key. This downloads a JSON file containing all three
# values below.
#
# WARNING: These grant full administrative access to your Firebase project.
# They must never appear in any NEXT_PUBLIC_ variable or client bundle.
# -----------------------------------------------------------------------------

# Required. Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID above.
FIREBASE_PROJECT_ID=your-project-id

# Required. Service account email from the downloaded JSON.
# Format: firebase-adminsdk-xxxxx@<project-id>.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=

# Required. The "private_key" value from the service account JSON.
#
# Paste it wrapped in DOUBLE QUOTES, keeping the literal \n escape sequences
# exactly as they appear in the JSON file. The application converts them back
# to real newlines at runtime.
#
# Correct (single line, quoted):
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
# Incorrect (raw multi-line paste — will fail to parse):
#   FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
#   MIIEvQIBADAN...
FIREBASE_PRIVATE_KEY=""


# =============================================================================
# 3. DEEPSEEK — SERVER-ONLY. NEVER EXPOSE.
# =============================================================================
# Where to find these: https://platform.deepseek.com/api_keys
#
# DEEPSEEK_API_KEY must only ever be read from server code. The browser never
# calls DeepSeek directly; it calls Seigem API routes, which authenticate the
# Firebase user and then call DeepSeek on the user's behalf.
# -----------------------------------------------------------------------------

# Required. Secret API key. Format: starts with "sk-".
DEEPSEEK_API_KEY=

# Optional. Override only if DeepSeek changes its endpoint or you use a proxy.
# Default: https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Standard model used by the Falas (Free) and Plus plans.
# Default: deepseek-flash
#
# NOTE: model ids verified against
# https://api-docs.deepseek.com/quick_start/pricing on the current API.
# The older `deepseek-chat` / `deepseek-reasoner` names are no longer the
# current models; `deepseek-flash` is the standard one.
DEEPSEEK_STANDARD_MODEL=deepseek-flash

# Optional. Stronger model used by the Pro plan.
# Default: deepseek-v4-pro
#
# Selection logic lives in `src/server/ai/models.ts`:
#   - Falas / Plus -> always DEEPSEEK_STANDARD_MODEL.
#   - Pro          -> DEEPSEEK_PRO_MODEL for reasoning-heavy generation
#                     (quiz construction), DEEPSEEK_STANDARD_MODEL otherwise,
#                     because the stronger model is slower and costs more.
DEEPSEEK_PRO_MODEL=deepseek-v4-pro


# =============================================================================
# 4. WHOP — SERVER-ONLY. NEVER EXPOSE.
# =============================================================================
# Where to find these:
#   WHOP_API_KEY          -> Whop dashboard -> Developer / API keys
#   WHOP_WEBHOOK_SECRET   -> Whop dashboard -> Webhooks -> your endpoint secret
#   WHOP_*_PRODUCT_ID     -> Whop dashboard -> Products -> the product's id
#
# WHOP_WEBHOOK_SECRET verifies that subscription events genuinely came from
# Whop. A verified webhook is the ONLY thing allowed to upgrade a user's plan —
# never a frontend redirect back from checkout.
# -----------------------------------------------------------------------------

# Required. Secret API key used for server-to-server Whop calls.
WHOP_API_KEY=

# Required. Signing secret for verifying webhook authenticity.
# Requests failing signature verification must be rejected with 401.
WHOP_WEBHOOK_SECRET=

# Required. Whop product id that grants the Plus plan (5.99€ / month).
# Format: MUST start with "prod_". A "plan_..." value here is a misconfiguration:
# membership webhooks report the PRODUCT id, so a plan id here means the webhook
# matches no product and NO paid plan is ever granted — the customer pays and
# stays on Free.
#
# Find it with: GET /api/v1/plans/<plan id> and read `product.id`, or from
# Whop dashboard -> Products.
WHOP_PLUS_PRODUCT_ID=

# Required. Whop product id that grants the Pro plan (12.99€ / month).
# Format: MUST start with "prod_". See the note above.
WHOP_PRO_PRODUCT_ID=

# Required to SELL anything. Whop PLAN ids used to open a checkout.
# Format: starts with "plan_"
#
# These are NOT the product ids above. A Whop product owns one or more plans,
# and the checkout API takes a plan. Find them in the Whop dashboard under the
# product's plans, or via GET /plans.
#
# Why this matters: opening a checkout CREATES a checkout configuration whose
# metadata carries the buyer's account id, which Whop copies onto the resulting
# membership. That metadata is the only thing that tells the webhook which
# Seigem account paid. Without these ids, checkout is refused rather than
# taking a payment that could never be attributed to a user.
WHOP_PLUS_PLAN_ID=
WHOP_PRO_PLAN_ID=

# Optional. Base URL of the Whop REST API. Must keep the /api/v1 path.
# Default: https://api.whop.com/api/v1
# Sandbox: https://sandbox-api.whop.com/api/v1
WHOP_BASE_URL=https://api.whop.com/api/v1


# =============================================================================
# 5. APPLICATION — PUBLIC
# =============================================================================
# -----------------------------------------------------------------------------

# Optional. Base URL of the deployed app. Used for Whop redirect URLs and
# absolute links. A trailing slash is stripped automatically.
#   Local development: http://localhost:3000
#   Production:        https://your-domain.com
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# QUICK REFERENCE
# =============================================================================
# Required to sell (16):
#   NEXT_PUBLIC_FIREBASE_API_KEY
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   NEXT_PUBLIC_FIREBASE_APP_ID
#   FIREBASE_PROJECT_ID
#   FIREBASE_CLIENT_EMAIL
#   FIREBASE_PRIVATE_KEY
#   DEEPSEEK_API_KEY
#   WHOP_API_KEY
#   WHOP_WEBHOOK_SECRET
#   WHOP_PLUS_PRODUCT_ID
#   WHOP_PRO_PRODUCT_ID
#   WHOP_PLUS_PLAN_ID
#   WHOP_PRO_PLAN_ID
#
# Optional, with defaults (6):
#   NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET  (empty — Cloud Storage unused)
#   DEEPSEEK_BASE_URL                    -> https://api.deepseek.com
#   DEEPSEEK_STANDARD_MODEL              -> deepseek-flash
#   DEEPSEEK_PRO_MODEL                   -> deepseek-v4-pro
#   NEXT_PUBLIC_APP_URL                  -> http://localhost:3000
#   WHOP_BASE_URL                        -> https://api.whop.com/api/v1
#
# PUBLIC (visible in the browser bundle) — 7:
#   NEXT_PUBLIC_FIREBASE_API_KEY
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   NEXT_PUBLIC_FIREBASE_APP_ID
#   NEXT_PUBLIC_APP_URL
#
# SERVER-ONLY (must never reach the browser) — 14:
#   FIREBASE_PROJECT_ID
#   FIREBASE_CLIENT_EMAIL
#   FIREBASE_PRIVATE_KEY
#   DEEPSEEK_API_KEY
#   DEEPSEEK_BASE_URL
#   DEEPSEEK_STANDARD_MODEL
#   DEEPSEEK_PRO_MODEL
#   WHOP_API_KEY
#   WHOP_WEBHOOK_SECRET
#   WHOP_PLUS_PRODUCT_ID
#   WHOP_PRO_PRODUCT_ID
#   WHOP_PLUS_PLAN_ID
#   WHOP_PRO_PLAN_ID
#   WHOP_BASE_URL
# =============================================================================
